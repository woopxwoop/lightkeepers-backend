{
  "builds": [
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/abyss",
      "schedule": "0 14 1-15/4,16-17,18-31/4 * *"
    },
    {
      "path": "/cron/stygian",
      "schedule": "0 15 */4 * *"
    }
  ]
}
