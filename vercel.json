{
  "builds":[
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes":[
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/daily",
      "schedule": "0 0 16-17 * *"
    },
    {
      "path": "/cron/daily",
      "schedule": "0 0 1-15/4,18-31/4 * *"
    }
  ]
}