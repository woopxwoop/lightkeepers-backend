{
  "builds":[
    {
      "src": "app/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes":[
    {
      "src": "/(.*)",
      "dest": "app/main.py"
    }
  ],
  "crons": [
    {
      "path": "/cron/abyss",
      "schedule": "0 0 16-17 * *"
    },
    {
      "path": "/cron/abyss",
      "schedule": "0 0 1-15/7,18-31/7 * *"
    },
    {
      "path": "/cron/characters",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/cron/versions",
      "schedule": "0 0 * * *"
    }
  ]
}